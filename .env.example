# Copy to .env and fill in.

# HuggingFace token for model downloads.
HF_TOKEN=

# Self-hosted vLLM on the H100 (this is the default the agent assumes).
# VLLM_MODEL must match whatever you pass to vLLM via scripts/start_vllm.sh -
# if you serve an FP8 / AWQ / GPTQ variant, change the id accordingly.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
OPENAI_API_KEY=not-needed

# Optional: point the agent at any OpenAI-compatible API so you can build and
# debug the Phase 3 graph without a running vLLM. Uncomment and fill in, then
# switch back to the defaults above for final prompt tuning and all of Phases 5-6.
# VLLM_BASE_URL=https://api.openai.com/v1
# VLLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Langfuse keys - you'll get these in Phase 4 after creating a project
# in the local Langfuse UI at http://localhost:3001.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
